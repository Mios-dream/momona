---
import StaticLayout from '../layouts/StaticLayout.astro';
import AppShell from '../components/app/AppShell.vue';
import { getDataCenter } from '../lib/dataCenter';

const { siteData, localConfig } = await getDataCenter();
---

<StaticLayout title="数据报告 · Love on the page" description="个人数字生活的静态数据报告。">
  <AppShell page="reports" siteData={siteData} localConfig={localConfig} editable={import.meta.env.DEV} client:load />
</StaticLayout>
