  }

  .blog-reader-panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--reader-divider);
  }

  .blog-reader-panel-heading strong {
    color: var(--reader-ink);
    font-size: 0.76rem;
    font-weight: 780;
  }

  .blog-reader-close {
    width: 27px;
    height: 27px;
    border-radius: 8px;
    box-shadow: none;
  }

  .blog-reader-close:hover,
  .blog-reader-close:focus-visible {
    color: var(--reader-ink);
    background: var(--reader-accent-soft);
    outline: none;
  }

  .blog-reader-fieldset {
    min-width: 0;
    margin: 14px 0 0;
    padding: 0;
    border: 0;
  }

  .blog-reader-fieldset legend {
    margin-bottom: 7px;
    color: var(--reader-muted);
    font-size: 0.62rem;
  }

  .blog-reader-segmented {
    display: flex;
    gap: 5px;
  }

  .blog-reader-segmented button,
  .blog-reader-swatches button {
    min-width: 0;
    min-height: 37px;
    padding: 5px 6px;
    border: 1px solid var(--reader-divider);
    border-radius: 7px;
    color: var(--reader-muted-strong);
    background: rgba(255, 255, 255, 0.34);
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background-color 0.16s ease;
  }

  .blog-reader-segmented button {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex-direction: column;
  }

  .blog-reader-segmented--line button {
    min-height: 32px;
    font-size: 0.6rem;
  }

  .blog-reader-segmented button:hover,
  .blog-reader-segmented button:focus-visible,
  .blog-reader-swatches button:hover,
  .blog-reader-swatches button:focus-visible,
  .blog-reader-segmented button.is-active,
  .blog-reader-swatches button.is-active {
    border-color: var(--reader-accent);
    color: var(--reader-accent);
    background: var(--reader-accent-soft);
    outline: none;
  }

  .reader-font-preview {
    display: block;
    color: var(--reader-ink);
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1;
  }

  .reader-font-preview--small {
    font-size: 0.77rem;
  }

  .reader-font-preview--medium {
    font-size: 0.92rem;
  }

  .reader-font-preview--large {
    font-size: 1.06rem;
  }

  .reader-font-preview--xlarge {
    font-size: 1.2rem;
  }

  .blog-reader-segmented small {
    color: inherit;
    font-size: 0.56rem;
  }

  .blog-reader-swatches {
    display: flex;
    gap: 8px;
  }

  .blog-reader-swatches button {
    display: grid;
    width: 36px;
    height: 36px;
    padding: 4px;
    place-items: center;
  }

  .reader-swatch {
    display: block;
    width: 22px;
    height: 22px;
    border: 1px solid rgba(23, 33, 51, 0.14);
    border-radius: 50%;
  }

  .reader-swatch--paper {
    background: #f4f6fb;
  }

  .reader-swatch--warm {
    background: #f1eadf;
  }

  .reader-swatch--mist {
    background: #e8f1f4;
  }

  .reader-swatch--night {
    border-color: rgba(255, 255, 255, 0.2);
    background: #20242e;
  }

  .blog-reader-reset {
    display: inline-flex;
    width: 100%;
    margin-top: 15px;
    padding: 8px 0 0;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;
    border-top: 1px solid var(--reader-divider);
    color: var(--reader-muted);
    background: transparent;
    font-size: 0.61rem;
  }

  .blog-reader-reset:hover,
  .blog-reader-reset:focus-visible {
    color: var(--reader-accent);
    outline: none;
  }

  .blog-post {
    border-color: var(--reader-divider);
    color: var(--reader-ink-soft);
    background: var(--reader-surface);
    box-shadow: 0 22px 58px rgba(54, 45, 106, 0.14);
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .blog-post-shell[data-reader-theme="night"] .blog-post {
    box-shadow: 0 22px 58px rgba(8, 11, 18, 0.28);
  }

  .blog-post-back,
  .blog-post-footer a {
    color: var(--reader-accent);
  }

  .blog-post-back:hover,
  .blog-post-back:focus-visible,
  .blog-post-footer a:hover,
  .blog-post-footer a:focus-visible {
    color: var(--reader-ink);
    outline: none;
  }

  .blog-post-header {
    border-bottom-color: var(--reader-divider);
  }

  .blog-post-meta {
    color: var(--reader-muted);
  }

  .blog-post-tags span {
    color: var(--reader-accent);
    background: var(--reader-accent-soft);
  }

  .blog-post-header h1,
  .blog-markdown h2,
  .blog-markdown h3,
  .blog-markdown h4,
  .blog-markdown strong {
    color: var(--reader-ink);
  }

  .blog-post-header p,
  .blog-markdown,
  .blog-markdown blockquote {
    color: var(--reader-ink-soft);
  }

  .blog-markdown {
    font-size: calc(1rem * var(--article-font-scale));
    line-height: var(--article-line-height);
  }

  .blog-markdown h2,
  .blog-markdown h3,
  .blog-markdown h4 {
    scroll-margin-top: 84px;
  }

  .blog-markdown h2 {
    font-size: calc(1.45rem * var(--article-font-scale));
  }

  .blog-markdown h3 {
    font-size: calc(1.2rem * var(--article-font-scale));
  }

  .blog-markdown h4 {
    font-size: calc(1.05rem * var(--article-font-scale));
  }

  .blog-markdown a {
    color: var(--reader-accent);
    text-decoration-color: var(--reader-accent-soft);
  }

  .blog-markdown blockquote {
    border-left-color: var(--reader-accent);
  }

  .blog-markdown code {
    color: var(--reader-accent);
    background: var(--reader-accent-soft);
  }

  .blog-markdown pre {
    border-color: var(--reader-divider);
    background: var(--reader-code);
  }

  .blog-markdown hr,
  .blog-post-footer {
    border-top-color: var(--reader-divider);
  }

  .blog-post-footer {
    margin-top: 52px;
    padding-top: 24px;
  }

  .blog-post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .blog-post-nav-link {
    display: flex;
    min-width: 0;
    min-height: 66px;
    padding: 12px 14px;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--reader-divider);
    border-radius: 12px;
    color: var(--reader-accent);
    background: var(--reader-toc-surface);
    box-shadow: 0 8px 20px rgba(74, 65, 52, 0.06);
    text-align: left;
    transition:
      color 0.16s ease,
      background-color 0.16s ease,
      border-color 0.16s ease,
      transform 0.16s ease;
  }

  .blog-post-nav-link--next {
    justify-content: flex-end;
    text-align: right;
  }

  .blog-post-nav-link svg {
    flex: 0 0 auto;
  }

  .blog-post-nav-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
  }

  .blog-post-nav-label {
    color: var(--reader-muted);
    font-size: 0.58rem;
    line-height: 1.2;
  }

  .blog-post-nav-copy strong {
    overflow: hidden;
    color: var(--reader-ink);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .blog-post-nav-link:hover,
  .blog-post-nav-link:focus-visible {
    border-color: var(--reader-accent);
    color: var(--reader-ink);
    background: var(--reader-accent-soft);
    outline: none;
    transform: translateY(-1px);
  }

  .blog-post-nav-link:hover .blog-post-nav-copy strong,
  .blog-post-nav-link:focus-visible .blog-post-nav-copy strong {
    color: var(--reader-ink);
  }

  .blog-post-nav-link.is-disabled,
  .blog-post-nav-link:disabled,
  .blog-post-nav-link.is-disabled:hover,
  .blog-post-nav-link:disabled:hover {
    cursor: not-allowed;
    border-color: var(--reader-divider);
    color: var(--reader-muted);
    background: rgba(255, 253, 247, 0.46);
    box-shadow: none;
    opacity: 0.58;
    transform: none;
  }

  .blog-post-nav-link.is-disabled .blog-post-nav-copy strong,
  .blog-post-nav-link:disabled .blog-post-nav-copy strong {
    color: var(--reader-muted);
  }

  /* Reader layout: keep the article open on the page and reserve cards for controls. */
  .blog-post-shell {
    --reader-frame-width: min(848px, calc(100vw - 240px));
    --reader-shell: #f8f5ec;
    --reader-surface: transparent;
    --reader-toc-surface: rgba(255, 253, 247, 0.9);
    --reader-ink: #292725;
    --reader-ink-soft: #4e4a45;
    --reader-muted: #7d7870;
    --reader-muted-strong: #625e57;
    --reader-accent: #6c665d;
    --reader-accent-soft: rgba(108, 102, 93, 0.11);
    --reader-divider: rgba(108, 102, 93, 0.18);
    --reader-code: #292725;
    padding: 94px 24px 100px;
    background: var(--reader-shell);
  }

  .blog-post-shell[data-reader-theme="paper"] {
    --reader-shell: #f8f5ec;
    --reader-surface: transparent;
    --reader-toc-surface: rgba(255, 253, 247, 0.9);
    --reader-ink: #292725;
    --reader-ink-soft: #4e4a45;
    --reader-muted: #7d7870;
    --reader-muted-strong: #625e57;
    --reader-accent: #6c665d;
    --reader-accent-soft: rgba(108, 102, 93, 0.11);
    --reader-divider: rgba(108, 102, 93, 0.18);
  }

  .reader-swatch--paper {
    background: #f8f5ec;
  }

  .blog-post-shell[data-reader-theme="warm"] {
    --reader-shell: #f1eadf;
    --reader-surface: transparent;
    --reader-toc-surface: rgba(255, 251, 242, 0.92);
  }

  .blog-post-shell[data-reader-theme="mist"] {
    --reader-shell: #e8f1f4;
    --reader-surface: transparent;
    --reader-toc-surface: rgba(249, 253, 255, 0.92);
  }

  .blog-post-shell[data-reader-theme="night"] {
    --reader-shell: #20242e;
    --reader-surface: transparent;
    --reader-toc-surface: rgba(43, 49, 62, 0.95);
  }

  .blog-post-frame {
    width: var(--reader-frame-width);
  }

  .blog-post {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .blog-post-header {
    padding: 0 0 30px;
    border-bottom-color: var(--reader-divider);
  }

  .blog-post-header h1 {
    font-size: clamp(2.15rem, 5vw, 2.85rem);
    letter-spacing: 0;
  }

  .blog-post-cover {
    max-height: 520px;
    margin-top: 31px;
    border-radius: 16px;
  }

  .blog-markdown {
    padding-top: 29px;
  }

  .blog-post-back {
    display: none;
    width: 40px;
    height: 40px;
    margin-bottom: 22px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--reader-divider);
    border-radius: 11px;
    background: var(--reader-toc-surface);
    box-shadow: 0 8px 20px rgba(74, 65, 52, 0.07);
    transition:
      color 0.16s ease,
      background-color 0.16s ease,
      border-color 0.16s ease,
      transform 0.16s ease;
  }

  .blog-post-back:hover,
  .blog-post-back:focus-visible {
    border-color: var(--reader-accent);
    background: var(--reader-accent-soft);
    transform: translateY(-1px);
  }

  .blog-reading-rail {
    position: fixed;
    z-index: 31;
    top: 50%;
    left: max(14px, calc((100vw - var(--reader-frame-width)) / 2 - 100px));
    display: flex;
    width: 58px;
    padding: 10px 8px;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    border: 1px solid rgba(108, 102, 93, 0.16);
    border-radius: 16px;
    background: var(--reader-toc-surface);
    box-shadow: 0 12px 28px rgba(74, 65, 52, 0.09);
    transform: translateY(-50%);
    transition:
      opacity 0.22s ease,
      visibility 0.22s ease;
    backdrop-filter: blur(18px) saturate(125%);
  }

  .blog-reading-rail-button,
  .blog-reading-rail .blog-toc-toggle {
    display: grid;
    width: 40px;
    height: 40px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 11px;
    color: var(--reader-muted-strong);
    background: transparent;
    transition:
      color 0.16s ease,
      background-color 0.16s ease,
      transform 0.16s ease;
  }

  .blog-reading-rail-button:hover,
  .blog-reading-rail-button:focus-visible,
  .blog-reading-rail .blog-toc-toggle:hover,
  .blog-reading-rail .blog-toc-toggle:focus-visible {
    color: var(--reader-ink);
    background: var(--reader-accent-soft);
    outline: none;
    transform: translateY(-1px);
  }

  .blog-reading-rail-divider {
    display: block;
    width: 27px;
    height: 1px;
    background: var(--reader-divider);
  }

  .blog-reading-progress-ring {
    position: relative;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 50%;
    background: conic-gradient(
      var(--reader-accent) var(--reading-progress-angle, 0deg),
      var(--reader-accent-soft) 0deg
    );
  }

  .blog-reading-progress-ring::before {
    position: absolute;
    inset: 3px;
    border-radius: inherit;
    background: var(--reader-toc-surface);
    content: "";
  }

  .blog-reading-progress-ring span {
    position: relative;
    z-index: 1;
    color: var(--reader-accent);
    font-size: 0.56rem;
    font-variant-numeric: tabular-nums;
  }

  .blog-reading-rail .blog-toc-toggle {
    position: static;
    display: grid;
    width: 40px;
    height: 40px;
    transform: none;
  }

  .blog-post-toc {
    top: 50%;
    left: max(14px, calc((100vw - var(--reader-frame-width)) / 2 - 12px));
    width: 220px;
    max-height: calc(100vh - 160px);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) translateX(-8px);
    visibility: hidden;
  }

  .blog-post-toc.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%);
    visibility: visible;
  }

  .blog-post-toc-label {
    display: inline;
  }

  /* Direct reader controls: the toolbar stays available without a secondary menu. */
  .blog-reader-controls {
    position: fixed;
    z-index: 35;
    top: 50%;
    right: max(14px, calc((100vw - var(--reader-frame-width)) / 2 - 108px));
    display: flex;
    width: fit-content;
    min-width: 0;
    min-height: 350px;
    padding: 11px 7px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    border: 1px solid rgba(108, 102, 93, 0.16);
    border-radius: 17px;
    background: var(--reader-toc-surface);
    box-shadow: 0 14px 32px rgba(74, 65, 52, 0.11);
    transform: translateY(-50%);
    transition:
      opacity 0.22s ease,
      visibility 0.22s ease;
    backdrop-filter: blur(18px) saturate(125%);
  }

  .blog-post-shell.is-reader-toolbar-hidden .blog-reading-rail,
  .blog-post-shell.is-reader-toolbar-hidden .blog-reader-controls,
  .blog-post-shell.is-reader-toolbar-hidden .blog-post-toc {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .blog-reader-control-group {
    display: flex;
    width: auto;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .blog-reader-control-button,
  .blog-reader-step-button,
  .blog-reader-reset {
    display: grid;
    padding: 0;
    place-items: center;
    border: 0;
    color: var(--reader-muted-strong);
    background: transparent;
    transition:
      color 0.16s ease,
      background-color 0.16s ease,
      opacity 0.16s ease,
      transform 0.16s ease;
  }

  .blog-reader-control-button {
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid transparent;
    border-radius: 12px;
  }

  .blog-mobile-toc-toggle {
    display: none;
  }

  .blog-reader-control-button:hover,
  .blog-reader-control-button:focus-visible,
  .blog-reader-step-button:hover,
  .blog-reader-step-button:focus-visible,
  .blog-reader-reset:hover,
  .blog-reader-reset:focus-visible {
    color: var(--reader-ink);
    background: var(--reader-accent-soft);
    outline: none;
    transform: translateY(-1px);
  }

  .blog-reader-theme-swatch {
    position: absolute;
    right: 7px;
    bottom: 7px;
    width: 8px;
    height: 8px;
    border: 1px solid rgba(108, 102, 93, 0.25);
    border-radius: 50%;
    background: #f8f5ec;
  }

  .blog-reader-theme-swatch[data-reader-theme="paper"] {
    background: #f8f5ec;
  }

  .blog-reader-theme-swatch[data-reader-theme="warm"] {
    background: #f1eadf;
  }

  .blog-reader-theme-swatch[data-reader-theme="mist"] {
    background: #e8f1f4;
  }

  .blog-reader-theme-swatch[data-reader-theme="night"] {
    border-color: rgba(255, 255, 255, 0.25);
    background: #20242e;
  }

  .blog-reader-control-mark {
    display: grid;
    width: 40px;
    height: 23px;
    place-items: center;
    color: var(--reader-muted);
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1;
  }

  .blog-reader-control-divider {
    display: block;
    width: 34px;
    height: 1px;
    flex: 0 0 auto;
    background: var(--reader-divider);
  }

  .blog-mobile-toc-divider {
    display: none;
  }

  .blog-reader-stepper {
    display: flex;
    width: 100%;
    padding: 7px 0;
    align-items: center;
    flex-direction: column;
    gap: 0;
    border-radius: 13px;
    background: var(--reader-accent-soft);
  }

  .blog-reader-step-button {
    width: 36px;
    height: 25px;
    border-radius: 7px;
  }

  .blog-reader-step-button--line svg {
    opacity: 0.86;
  }

  .blog-reader-step-button:disabled {
    cursor: not-allowed;
    opacity: 0.28;
  }

  .blog-reader-step-button:disabled:hover {
    color: var(--reader-muted-strong);
    background: transparent;
    transform: none;
  }

  .blog-reader-control-value {
    display: grid;
    width: 100%;
    height: 22px;
    place-items: center;
    min-width: 0;
    color: var(--reader-ink);
    font-size: 0.57rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
  }

  .blog-reader-reset {
    width: 32px;
    height: 28px;
    flex: 0 0 auto;
    border-top: 1px solid var(--reader-divider);
    color: var(--reader-muted);
  }

  .blog-reader-reset svg {
    margin-top: 7px;
  }

  .blog-reader-reset-divider {
    display: none;
  }

  @media (min-width: 621px) {
    .blog-reader-stepper {
      width: 40px;
      padding: 7px 0;
      gap: 0;
      border-radius: 13px;
      background: var(--reader-accent-soft);
    }

    .blog-reader-step-button {
      width: 32px;
      height: 32px;
      border-radius: 9px;
    }

    .blog-reader-control-value {
      width: 100%;
      height: 22px;
    }

    .blog-reader-reset-divider {
      display: block;
      width: 34px;
      height: 1px;
      flex: 0 0 auto;
      background: var(--reader-divider);
    }

    .blog-reader-reset {
      width: 32px;
      height: 32px;
