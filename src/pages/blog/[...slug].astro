---
import { render, type CollectionEntry } from "astro:content";
import StaticLayout from "../../layouts/StaticLayout.astro";
import { getDataCenter } from "../../lib/dataCenter";
import { blogArticlePath } from "../../data/blog";
import {
  formatBlogDate,
  getBlogCoverSource,
  getPublishedBlogArticles,
} from "../../lib/blog";
import IconGlyph from "../../components/app/IconGlyph.vue";

export async function getStaticPaths() {
  const articles = await getPublishedBlogArticles();

  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: {
      article,
      previousArticle: articles[index - 1],
      nextArticle: articles[index + 1],
    },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
  previousArticle?: CollectionEntry<"articles">;
  nextArticle?: CollectionEntry<"articles">;
}

const { article, previousArticle, nextArticle } = Astro.props as Props;
const { Content } = await render(article);
const { localConfig } = await getDataCenter();
const publishedDate = formatBlogDate(article.data.pubDate);
const updatedDate = article.data.updatedDate
  ? formatBlogDate(article.data.updatedDate)
  : undefined;
const coverSource = getBlogCoverSource(article.data.cover);
const description =
  article.data.description || `${article.data.title} · ${localConfig.site.title}`;
---

<StaticLayout
  title={article.data.title}
  description={description}
  siteTitle={localConfig.site.title}
  siteDescription={localConfig.site.description}
  favicon={localConfig.site.favicon}
>
  <main class="blog-post-shell" data-reading-page data-reader-theme="paper">
    <div
      class="blog-reading-progress"
      data-reading-progress
      role="progressbar"
      aria-label="文章阅读进度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span data-reading-progress-bar></span>
    </div>

    <aside class="blog-reading-rail" aria-label="阅读工具">
      <a
        class="blog-reading-rail-button blog-reading-back"
        href="/brew/"
        aria-label="返回 Brew 阅读"
        title="返回 Brew 阅读"
      >
        <IconGlyph name="arrowLeft" size={17} />
      </a>
      <span class="blog-reading-rail-divider" aria-hidden="true"></span>
      <div
        class="blog-reading-progress-ring"
        data-progress-ring
        role="progressbar"
        aria-label="文章阅读进度"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <span data-progress-label>0%</span>
      </div>
      <span class="blog-reading-rail-divider" aria-hidden="true"></span>
      <button
        class="blog-toc-toggle"
        data-toc-toggle
        type="button"
        aria-label="打开文章目录"
        aria-controls="blog-post-toc"
        aria-expanded="false"
        title="文章目录"
      >
        <IconGlyph name="listOrdered" size={17} />
      </button>
    </aside>

    <aside
      class="blog-post-toc"
      id="blog-post-toc"
      data-toc-panel
      aria-label="文章目录"
      aria-hidden="true"
    >
      <div class="blog-post-toc-heading">
        <span class="blog-post-toc-title">
          <IconGlyph name="listOrdered" size={16} />
          <span class="blog-post-toc-label">文章目录</span>
        </span>
        <span class="blog-post-toc-count" data-toc-count>0</span>
      </div>
      <nav class="blog-post-toc-nav" aria-label="文章目录">
        <ol class="blog-post-toc-list" data-toc></ol>
      </nav>
      <div class="blog-post-progress-copy">
        <span>阅读进度</span>
        <strong data-progress-label>0%</strong>
      </div>
      <div class="blog-post-progress-track" aria-hidden="true">
        <span data-progress-bar></span>
      </div>
    </aside>

    <aside class="blog-reader-controls" data-reader-controls aria-label="阅读设置">
      <button
        class="blog-reader-control-button blog-mobile-toc-toggle"
        data-toc-toggle
        type="button"
        aria-label="打开文章目录"
        aria-controls="blog-post-toc"
        aria-expanded="false"
        title="文章目录"
      >
        <IconGlyph name="listOrdered" size={17} />
      </button>
      <span
        class="blog-reader-control-divider blog-mobile-toc-divider"
        aria-hidden="true"
      ></span>

      <div class="blog-reader-control-group blog-reader-control-group--theme">
        <button
          class="blog-reader-control-button blog-reader-theme-toggle"
          data-reader-theme-toggle
          type="button"
          aria-label="切换背景颜色"
          title="切换背景颜色"
        >
          <IconGlyph name="palette" size={18} />
          <span
            class="blog-reader-theme-swatch"
            data-reader-theme-swatch
            aria-hidden="true"
          ></span>
        </button>
      </div>

      <span class="blog-reader-control-divider" aria-hidden="true"></span>

      <div class="blog-reader-control-group" role="group" aria-label="字号">
        <span class="blog-reader-control-mark" aria-hidden="true">字</span>
        <div class="blog-reader-stepper">
          <button
            class="blog-reader-step-button"
            data-reader-font-increase
            type="button"
            aria-label="增大字号"
            title="增大字号"
          >
            <IconGlyph name="plus" size={14} />
          </button>
          <output class="blog-reader-control-value" data-reader-font-value>100%</output>
          <button
            class="blog-reader-step-button"
            data-reader-font-decrease
            type="button"
            aria-label="减小字号"
            title="减小字号"
          >
            <IconGlyph name="minus" size={14} />
          </button>
        </div>
      </div>

      <span class="blog-reader-control-divider" aria-hidden="true"></span>

      <div class="blog-reader-control-group" role="group" aria-label="行间距">
        <div class="blog-reader-stepper">
          <button
            class="blog-reader-step-button blog-reader-step-button--line"
            data-reader-line-increase
            type="button"
            aria-label="增大行间距"
            title="增大行间距"
          >
            <IconGlyph name="menu" size={16} />
          </button>
          <output class="blog-reader-control-value" data-reader-line-value>1.95</output>
          <button
            class="blog-reader-step-button blog-reader-step-button--line"
            data-reader-line-decrease
            type="button"
            aria-label="减小行间距"
            title="减小行间距"
          >
            <IconGlyph name="menu" size={16} />
          </button>
        </div>
      </div>

      <span class="blog-reader-reset-divider" aria-hidden="true"></span>
      <button
        class="blog-reader-control-button blog-reader-reset"
        data-reader-reset
        type="button"
        aria-label="恢复默认阅读设置"
        title="恢复默认"
      >
        <IconGlyph name="refresh" size={14} />
      </button>
    </aside>

    <div class="blog-post-frame">
      <a
        class="blog-post-back"
        href="/brew/"
        aria-label="返回 Brew 阅读"
        title="返回 Brew 阅读"
      >
        <IconGlyph name="arrowLeft" size={18} />
      </a>

      <article class="blog-post" data-reader-article>
        <header class="blog-post-header">
          <div class="blog-post-meta">
            <time datetime={article.data.pubDate.toISOString()}>{publishedDate}</time>
            {updatedDate && <span>更新于 {updatedDate}</span>}
            {article.data.tags.length > 0 && (
              <div class="blog-post-tags" aria-label="文章标签">
                {article.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
            )}
          </div>
          <h1>{article.data.title}</h1>
          {article.data.description && <p>{article.data.description}</p>}
        </header>

        {coverSource && (
          <img class="blog-post-cover" src={coverSource} alt={article.data.title} />
        )}

        <div class="blog-markdown">
          <Content />
        </div>

        <footer class="blog-post-footer">
          <nav class="blog-post-nav" aria-label="文章导航">
            {previousArticle ? (
              <a
                class="blog-post-nav-link blog-post-nav-link--previous"
                href={blogArticlePath(previousArticle.id)}
                aria-label={`上一篇：${previousArticle.data.title}`}
                title={previousArticle.data.title}
              >
                <IconGlyph name="arrowLeft" size={16} />
                <span class="blog-post-nav-copy">
                  <span class="blog-post-nav-label">上一篇</span>
                  <strong>{previousArticle.data.title}</strong>
                </span>
              </a>
            ) : (
              <button
                class="blog-post-nav-link blog-post-nav-link--previous is-disabled"
                type="button"
                disabled
                aria-label="没有上一篇"
              >
                <IconGlyph name="arrowLeft" size={16} />
                <span class="blog-post-nav-copy">
                  <span class="blog-post-nav-label">上一篇</span>
                  <strong>没有上一篇</strong>
                </span>
              </button>
            )}

            {nextArticle ? (
              <a
                class="blog-post-nav-link blog-post-nav-link--next"
                href={blogArticlePath(nextArticle.id)}
                aria-label={`下一篇：${nextArticle.data.title}`}
                title={nextArticle.data.title}
              >
                <span class="blog-post-nav-copy">
                  <span class="blog-post-nav-label">下一篇</span>
                  <strong>{nextArticle.data.title}</strong>
                </span>
                <IconGlyph name="arrowRight" size={16} />
              </a>
            ) : previousArticle ? (
              <button
                class="blog-post-nav-link blog-post-nav-link--next is-disabled"
                type="button"
                disabled
                aria-label="没有下一篇"
              >
                <span class="blog-post-nav-copy">
                  <span class="blog-post-nav-label">下一篇</span>
                  <strong>没有下一篇</strong>
                </span>
                <IconGlyph name="arrowRight" size={16} />
              </button>
            ) : (
              <button
                class="blog-post-nav-link blog-post-nav-link--next is-disabled"
                type="button"
                disabled
                aria-label="没有下一篇"
              >
                <span class="blog-post-nav-copy">
                  <span class="blog-post-nav-label">下一篇</span>
                  <strong>没有下一篇</strong>
                </span>
                <IconGlyph name="arrowRight" size={16} />
              </button>
            )}
          </nav>
        </footer>
      </article>
    </div>
  </main>
</StaticLayout>

<script>
  import "../../scripts/articleReader";
</script>

<style is:global>
  .blog-post-shell {
    min-height: 100vh;
    padding: 54px 24px 90px;
    background: #f4f6fb;
  }

  .blog-post-frame {
    width: min(820px, 100%);
    margin: 0 auto;
  }

  .blog-post-back {
    display: inline-flex;
    margin-bottom: 18px;
    color: var(--purple-deep);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .blog-post {
    padding: clamp(25px, 5vw, 58px) clamp(20px, 6vw, 72px) 50px;
    border: 1px solid var(--content-border);
    border-radius: 15px;
    background: var(--content-surface);
    box-shadow: 0 22px 58px rgba(54, 45, 106, 0.14);
  }

  .blog-post-header {
    padding-bottom: 31px;
    border-bottom: 1px solid rgba(117, 100, 222, 0.14);
  }

  .blog-post-meta {
    display: flex;
    min-width: 0;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 13px;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .blog-post-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .blog-post-tags span {
    padding: 4px 8px;
    border-radius: 999px;
    color: var(--purple-deep);
    background: rgba(242, 239, 255, 0.74);
  }

  .blog-post-header h1 {
    margin: 22px 0 0;
    color: var(--ink);
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 790;
    line-height: 1.18;
  }

  .blog-post-header p {
    margin: 17px 0 0;
    color: var(--muted-strong);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .blog-post-cover {
    display: block;
    width: 100%;
    max-height: 410px;
    margin: 30px 0 0;
    border-radius: 10px;
    object-fit: cover;
  }

  .blog-markdown {
    padding-top: 34px;
    color: var(--ink-soft);
    font-family: "Segoe UI", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    font-size: 1rem;
    line-height: 1.95;
    overflow-wrap: anywhere;
  }

  .blog-markdown > :first-child {
    margin-top: 0;
  }

  .blog-markdown h2,
  .blog-markdown h3,
  .blog-markdown h4 {
    margin: 2em 0 0.65em;
    color: var(--ink);
    font-family: "Segoe UI", sans-serif;
    line-height: 1.35;
  }

  .blog-markdown h2 {
    font-size: 1.45rem;
  }

  .blog-markdown h3 {
    font-size: 1.2rem;
  }

  .blog-markdown h4 {
    font-size: 1.05rem;
  }

  .blog-markdown p,
  .blog-markdown ul,
  .blog-markdown ol,
  .blog-markdown blockquote,
  .blog-markdown pre {
    margin: 1.05em 0;
  }

  .blog-markdown ul,
  .blog-markdown ol {
    padding-left: 1.4em;
  }

  .blog-markdown li + li {
    margin-top: 0.35em;
  }

  .blog-markdown a {
    color: var(--purple-deep);
    text-decoration: underline;
    text-decoration-color: rgba(117, 100, 222, 0.35);
    text-underline-offset: 3px;
  }

  .blog-markdown strong {
    color: var(--ink);
  }

  .blog-markdown blockquote {
    padding: 8px 0 8px 18px;
    border-left: 3px solid var(--pink);
    color: var(--muted-strong);
  }

  .blog-markdown code {
    padding: 0.15em 0.4em;
    border-radius: 5px;
    color: var(--purple-deep);
    background: rgba(242, 239, 255, 0.86);
    font-family: Consolas, "SFMono-Regular", monospace;
    font-size: 0.86em;
  }

  .blog-markdown pre {
    padding: 17px 18px;
    overflow-x: auto;
    border: 1px solid rgba(117, 100, 222, 0.12);
    border-radius: 9px;
    color: #eff3ff;
    background: #20263b;
    line-height: 1.65;
  }

  .blog-markdown pre code {
    padding: 0;
    color: inherit;
    background: transparent;
    font-size: 0.88em;
  }

  .blog-markdown img {
    display: block;
    height: auto;
    max-width: 100%;
    margin: 1.5em auto;
    border-radius: 9px;
  }

  .blog-markdown hr {
    margin: 2.2em 0;
    border: 0;
    border-top: 1px solid rgba(117, 100, 222, 0.15);
  }

  .blog-post-footer {
    margin-top: 38px;
    padding-top: 22px;
    border-top: 1px solid rgba(117, 100, 222, 0.14);
  }

  .blog-post-footer a {
    color: var(--purple-deep);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .blog-post-shell {
    position: relative;
    isolation: isolate;
    --reader-shell: #f4f6fb;
    --reader-surface: #fbfcff;
    --reader-toc-surface: rgba(255, 255, 255, 0.7);
    --reader-ink: #172133;
    --reader-ink-soft: #303b4f;
    --reader-muted: #758096;
    --reader-muted-strong: #5d6980;
    --reader-accent: #5541b5;
    --reader-accent-soft: rgba(117, 100, 222, 0.13);
    --reader-divider: rgba(117, 100, 222, 0.16);
    --reader-code: #20263b;
    --article-font-scale: 1;
    --article-line-height: 1.95;
    color: var(--reader-ink);
    background: var(--reader-shell);
    transition:
      color 0.25s ease,
      background-color 0.25s ease;
  }

  .blog-post-shell[data-reader-theme="warm"] {
    --reader-shell: #f1eadf;
    --reader-surface: #fffaf1;
    --reader-toc-surface: rgba(255, 251, 242, 0.82);
    --reader-ink: #3f3429;
    --reader-ink-soft: #5a4939;
    --reader-muted: #8b7765;
    --reader-muted-strong: #715d4a;
    --reader-accent: #946b3f;
    --reader-accent-soft: rgba(148, 107, 63, 0.13);
    --reader-divider: rgba(148, 107, 63, 0.2);
  }

  .blog-post-shell[data-reader-theme="mist"] {
    --reader-shell: #e8f1f4;
    --reader-surface: #fbfdfe;
    --reader-toc-surface: rgba(249, 253, 255, 0.78);
    --reader-ink: #203642;
    --reader-ink-soft: #36515e;
    --reader-muted: #748d98;
    --reader-muted-strong: #55717d;
    --reader-accent: #287a93;
    --reader-accent-soft: rgba(40, 122, 147, 0.13);
    --reader-divider: rgba(40, 122, 147, 0.18);
  }

  .blog-post-shell[data-reader-theme="night"] {
    --reader-shell: #20242e;
    --reader-surface: #2b313e;
    --reader-toc-surface: rgba(43, 49, 62, 0.94);
    --reader-ink: #edf0f7;
    --reader-ink-soft: #d3d9e6;
    --reader-muted: #9da8bb;
    --reader-muted-strong: #b6c0d1;
    --reader-accent: #b8aaff;
    --reader-accent-soft: rgba(184, 170, 255, 0.16);
    --reader-divider: rgba(184, 170, 255, 0.2);
    --reader-code: #171b24;
  }

  .blog-reading-progress {
    position: fixed;
    z-index: 80;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    overflow: hidden;
    pointer-events: none;
    background: rgba(117, 100, 222, 0.12);
  }

  .blog-reading-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--reader-accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--reader-accent) 42%, transparent);
    transition: width 0.16s ease;
  }

  .blog-post-frame {
    position: relative;
    z-index: 1;
    width: min(820px, 100%);
  }

  .blog-post-toc {
    position: fixed;
    z-index: 30;
    top: clamp(92px, 14vh, 154px);
    left: max(16px, calc((100vw - 1270px) / 2));
    display: flex;
    width: 198px;
    max-height: calc(100vh - 194px);
    padding: 15px 13px 13px;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 14px;
    background: var(--reader-toc-surface);
    box-shadow: 0 16px 36px rgba(54, 45, 106, 0.11);
    backdrop-filter: blur(18px) saturate(130%);
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.22s ease,
      transform 0.22s ease,
      visibility 0.22s ease;
  }

  .blog-post-toc-heading,
  .blog-post-progress-copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .blog-post-toc-heading {
    padding: 0 2px 11px;
    border-bottom: 1px solid var(--reader-divider);
  }

  .blog-post-toc-title {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 7px;
    color: var(--reader-ink);
    font-size: 0.7rem;
    font-weight: 780;
  }

  .blog-post-toc-title svg {
    flex: 0 0 auto;
    color: var(--reader-accent);
  }

  .blog-post-toc-count {
    display: inline-grid;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    place-items: center;
    border-radius: 6px;
    color: var(--reader-accent);
    background: var(--reader-accent-soft);
    font-size: 0.58rem;
    font-variant-numeric: tabular-nums;
  }

  .blog-post-toc-nav {
    min-height: 0;
    margin: 10px -5px 12px 0;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--reader-accent-soft) transparent;
  }

  .blog-post-toc-list {
    margin: 0;
    padding: 0 5px 0 0;
    list-style: none;
  }

  .blog-post-toc-item + .blog-post-toc-item {
    margin-top: 2px;
  }

  .blog-post-toc-item a {
    display: block;
    padding: 7px 8px;
    overflow: hidden;
    border-left: 2px solid transparent;
    border-radius: 4px;
    color: var(--reader-muted-strong);
    font-size: 0.64rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      color 0.16s ease,
      background-color 0.16s ease,
      border-color 0.16s ease;
  }

  .blog-post-toc-item--h3 a {
    padding-left: 18px;
    font-size: 0.61rem;
  }

  .blog-post-toc-item--h4 a {
    padding-left: 28px;
    font-size: 0.59rem;
  }

  .blog-post-toc-item a:hover,
  .blog-post-toc-item a:focus-visible,
  .blog-post-toc-item a.is-active {
    border-left-color: var(--reader-accent);
    color: var(--reader-accent);
    background: var(--reader-accent-soft);
    outline: none;
  }

  .blog-post-toc-empty {
    margin: 7px 8px;
    color: var(--reader-muted);
    font-size: 0.62rem;
  }

  .blog-post-progress-copy {
    padding: 11px 2px 7px;
    border-top: 1px solid var(--reader-divider);
    color: var(--reader-muted);
    font-size: 0.59rem;
  }

  .blog-post-progress-copy strong {
    color: var(--reader-accent);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
  }

  .blog-post-progress-track {
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--reader-accent-soft);
  }

  .blog-post-progress-track span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--reader-accent);
    transition: width 0.16s ease;
  }

  .blog-toc-toggle {
    display: none;
    position: fixed;
    z-index: 31;
    top: 50%;
    left: 14px;
    width: 45px;
    height: 45px;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 13px;
    color: var(--reader-accent);
    background: var(--reader-toc-surface);
    box-shadow: 0 12px 26px rgba(54, 45, 106, 0.14);
    transform: translateY(-50%);
    backdrop-filter: blur(18px) saturate(130%);
  }

  .blog-toc-toggle span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .blog-toc-toggle:hover,
  .blog-toc-toggle:focus-visible,
  .blog-toc-toggle[aria-expanded="true"] {
    color: var(--reader-ink);
    background: var(--reader-accent-soft);
    outline: none;
  }

  .blog-reader-controls {
    position: fixed;
    z-index: 35;
    top: 50%;
    right: max(16px, calc((100vw - 1270px) / 2));
    display: flex;
    align-items: flex-start;
    transform: translateY(-50%);
  }

  .blog-reader-toggle,
  .blog-reader-close {
    display: grid;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.82);
    color: var(--reader-accent);
    background: var(--reader-toc-surface);
    box-shadow: 0 12px 26px rgba(54, 45, 106, 0.13);
    backdrop-filter: blur(18px) saturate(130%);
  }

  .blog-reader-toggle {
    width: 45px;
    height: 45px;
    border-radius: 13px;
    transition:
      color 0.16s ease,
      background-color 0.16s ease,
      transform 0.16s ease;
  }

  .blog-reader-toggle:hover,
  .blog-reader-toggle:focus-visible,
  .blog-reader-controls.is-open .blog-reader-toggle {
    color: var(--reader-ink);
    background: var(--reader-accent-soft);
    outline: none;
    transform: translateY(-2px);
  }

  .blog-reader-panel {
    position: absolute;
    top: 0;
    right: calc(100% + 12px);
    width: 238px;
    padding: 15px;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 14px;
    color: var(--reader-ink-soft);
    background: var(--reader-toc-surface);
    box-shadow: 0 18px 42px rgba(54, 45, 106, 0.17);
    backdrop-filter: blur(20px) saturate(135%);
  }

  .blog-reader-panel[hidden] {
